SEC_USER_AGENT="Your Organization admin@yourdomain.com"
# 三个 Agent 使用 OpenAI；模型 ID 请替换为当前账户可用的型号。
CREWAI_MODEL=openai/gpt-4o-mini
OPENAI_API_KEY=
# 默认通过 SerpApi 搜索 Google 结果，再由 OpenAI Agent 分析。
SEARCH_PROVIDER=serpapi
SERPAPI_API_KEY=
# 可选：改用 Gemini Google Search Grounding 时，设置 SEARCH_PROVIDER=gemini_grounding 并填写以下密钥。
GEMINI_API_KEY=
GEMINI_SEARCH_MODEL=gemini-2.5-flash
# OPENAI_API_MODE=responses
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_ORGANIZATION=
# OPENAI_PROJECT=
# OPENAI_REASONING_EFFORT=medium
# OPENAI_MAX_COMPLETION_TOKENS=4000
# OPENAI_TIMEOUT=60
# OPENAI_MAX_RETRIES=2
RUNS_DIR=./runs
DATABASE_PATH=./runs/runs.db
FRONTEND_ORIGIN=
